[Service]
Restart=always
RestartSec=60


[Install]
WantedBy=default.target


[Container]
ContainerName=prometheus
Image=docker.io/prom/prometheus

User=1000:1000
UserNS=keep-id

Network=host

Exec=--web.listen-address=127.0.0.1:6550

Volume=%h/containers/prometheus/prometheus.yaml:/prometheus/prometheus.yml
Volume=%h/containers/prometheus/data/:/prometheus/
Volume=/etc/localtime:/etc/localtime:ro
