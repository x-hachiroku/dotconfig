[Unit]
ConditionPathIsMountPoint=/mnt/misesaki/

Wants=podman-user-wait-network-online.service
After=podman-user-wait-network-online.service


[Service]
Restart=always
RestartSec=60


[Install]
WantedBy=default.target


[Container]
ContainerName=hath
Image=ghcr.io/x-hachiroku/hath

Network=host

Ulimit=nofile=65536:65536

Volume=%h/containers/hath/:/data/
Volume=/mnt/misesaki/hath/:/cache/
Volume=/etc/localtime:/etc/localtime:ro
