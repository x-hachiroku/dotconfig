[Unit]
ConditionPathIsMountPoint=/mnt/cache/


[Service]
Restart=always
RestartSec=60


[Install]
WantedBy=default.target


[Container]
ContainerName=hath
Image=ghcr.io/x-hachiroku/hath

Network=host

Ulimit=nofile=65536:65536

Volume=%h/containers/hath/:/data
Volume=/mnt/cache/hath/:/cache/
Volume=/etc/localtime:/etc/localtime:ro
