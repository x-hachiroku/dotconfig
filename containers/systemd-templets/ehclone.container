[Unit]
Requires=postgres.service
After=postgres.service
ConditionPathIsMountPoint=/mnt/seki1
ConditionPathIsMountPoint=/mnt/kitchen


[Service]
Restart=always
RestartSec=60


[Install]
WantedBy=default.target


[Container]
ContainerName=ehclone
Image=ghcr.io/x-hachiroku/ehclone:master

Network=postgres.network

Volume=%h/containers/ehclone/:/appdata/
Volume=/mnt/seki1/ehclone/:/downloads/
Volume=/mnt/kitchen/ehclone/:/cache/
Volume=/etc/localtime:/etc/localtime:ro
