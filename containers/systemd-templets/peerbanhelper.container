[Service]
Restart=always
RestartSec=60


[Install]
WantedBy=default.target


[Container]
ContainerName=peerbanhelper
Image=docker.io/ghostchu/peerbanhelper

Environment=PBH_DOWNLOADER_QBITTORRENT_MAXCONCURRENTPEERREQUESTSLOTS=16

Network=host

Volume=%h/containers/peerbanhelper/:/app/data/
Volume=/etc/localtime:/etc/localtime:ro
